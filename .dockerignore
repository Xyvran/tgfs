# Keeps the build context small. Both images are built with `context: .`, so
# everything listed here would otherwise be uploaded to the builder on every
# build -- node_modules alone is by far the largest thing in the tree.
#
# Careful: Dockerfile.frontend needs `tgfs-gh-pages/` itself, so only its
# generated subdirectories may be excluded.

.git
.gitignore
.github
.pre-commit-config.yaml

# Python tooling and virtualenvs
.venv
venv
**/__pycache__
*.py[cod]
.mypy_cache
.pytest_cache
.ruff_cache
.coverage
coverage.xml
htmlcov

# Not part of either image. README.md is deliberately kept: pyproject.toml
# points its `readme` field at it.
tests
docs
scripts
makefile
tgfs.png

# Generated by the frontend build
tgfs-gh-pages/node_modules
tgfs-gh-pages/.next
tgfs-gh-pages/out

# Local secrets and state that must never end up in a build context
config.yaml
*.session
*.session-journal
master.salt
sftp_host_key
sftp_host_key.pub

# Editor and OS noise
.idea
.vscode
.DS_Store
